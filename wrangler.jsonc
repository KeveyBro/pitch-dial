// Cloudflare Workers config. Static files in public/ are served as assets; only /api/* runs
// worker/index.js. Branch previews deploy with --env preview, to a separate Worker with its own
// database, so testing never mixes practice games into the real results.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitch-dial",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pitch-dial-results",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "pitch-dial-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pitch-dial-results-preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
